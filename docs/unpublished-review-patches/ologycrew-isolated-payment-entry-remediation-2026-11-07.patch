+// A denial guard, not a mock. The injected fetch is the original native fetch
+// in setup; injection also lets contract tests inspect denials without egress.
+export function createGuardedFetch(nativeFetch: typeof globalThis.fetch, attempted: string[]): typeof globalThis.fetch {
+  return async (input, init) => {
+    const raw = input instanceof Request ? input.url : String(input);
+    const url = new URL(raw);
+
+    // Satori's import-time Yoga loader fetches its embedded WASM data URL.
+    // Native data: fetch decodes the URL's own bytes without a transport or a
+    // redirect. Pass through unchanged, including native rejection/abort
+    // behavior; never allow other opaque origins (file:, blob:, etc.).
+    if (url.protocol === "data:") return nativeFetch(input, init);
+
+    if (!(["127.0.0.1", "localhost", "[::1]"].includes(url.hostname) &&
+          url.protocol === "http:" && url.port && !["3000", "3306"].includes(url.port))) {
+      attempted.push(`fetch ${url.origin}`);
+      throw new Error(`Hermetic egress forbidden: ${url.origin}; mock the external boundary in its owning test`);
+    }
+    return nativeFetch(input, init);
+  };
+}
