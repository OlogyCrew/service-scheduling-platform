+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Request, Response } from "express";
+import router, { encodeGoogleOAuthState } from "../server/customAuthRouter";
+
+function callbackHandler() {
+  const layer = (router as any).stack.find((entry: any) => entry.route?.path === "/api/auth/google/callback");
+  if (!layer?.route?.stack?.[0]?.handle) throw new Error("Existing Google callback route missing");
+  return layer.route.stack[0].handle;
+}
+afterEach(() => vi.unstubAllGlobals());
+
+describe("LOCAL CONTRACT ONLY — Google rejected token exchange, not login health", () => {
+  it("posts the authorization-code contract and redirects on mocked token rejection before reading any user", async () => {
+    const fetchMock = vi.fn().mockResolvedValue(new Response("invalid_grant", { status: 400 }));
+    vi.stubGlobal("fetch", fetchMock);
+    const redirect = vi.fn();
+    const state = encodeGoogleOAuthState({ origin: "http://127.0.0.1:3999", audience: "", planTier: "", returnTo: "/my-bookings" });
+    const req = { query: { code: "local-rejected-code", state }, protocol: "http", get: () => "127.0.0.1:3999" } as unknown as Request;
+    await callbackHandler()(req, { redirect } as unknown as Response);
+    expect(redirect).toHaveBeenCalledWith("/login?error=token_exchange_failed");
+    expect(fetchMock).toHaveBeenCalledOnce();
+    const [url, request] = fetchMock.mock.calls[0];
+    expect(url).toBe("https://oauth2.googleapis.com/token");
+    expect(request.method).toBe("POST");
+    expect(JSON.parse(request.body)).toMatchObject({ code: "local-rejected-code", grant_type: "authorization_code", redirect_uri: "http://127.0.0.1:3999/api/auth/google/callback" });
+    // Empty client id/secret are intentionally not manufactured credentials.
+    expect(JSON.parse(request.body).client_secret).toBe("");
+  });
+  it("rejects tampered OAuth state before any external request", async () => {
+    const fetchMock = vi.fn(); vi.stubGlobal("fetch", fetchMock);
+    const redirect = vi.fn();
+    const req = { query: { code: "local-code", state: "tampered.signature" }, protocol: "http", get: () => "127.0.0.1:3999" } as unknown as Request;
+    await callbackHandler()(req, { redirect } as unknown as Response);
+    expect(redirect).toHaveBeenCalledWith("/login?error=invalid_state");
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+});
