+import { and, eq, inArray } from "drizzle-orm";
+import { TRPCError } from "@trpc/server";
+import { bookings, offlineBookingPayments, serviceProviders } from "../../drizzle/schema";
+import { getDb } from "./connection";
+import { BOOKING_LIST_PAYMENT_BATCH_SIZE, type BookingListPaymentSummary } from "../../shared/offlinePaymentBookingList";
+
+/** A single bounded SELECT for a visible list page; no ledger writes or finance calls. */
+export async function getBookingListPaymentSummaries(input: {
+  userId: number;
+  view: "customer" | "provider";
+  bookingIds: number[];
+}): Promise<BookingListPaymentSummary[]> {
+  const ids = Array.from(new Set(input.bookingIds));
+  if (
+    !ids.length || input.bookingIds.length > BOOKING_LIST_PAYMENT_BATCH_SIZE ||
+    !ids.every(id => Number.isSafeInteger(id) && id > 0)
+  ) throw new TRPCError({ code: "BAD_REQUEST", message: "Invalid booking-list page." });
+
+  const db = await getDb();
+  // Unavailable is not an authoritative no-offline answer.
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Payment status unavailable." });
+
+  const projection = {
+    bookingId: bookings.id,
+    offlineBookingId: offlineBookingPayments.bookingId,
+    status: offlineBookingPayments.status,
+    originalAmountDue: offlineBookingPayments.originalAmountDue,
+  };
+  const base = db.select(projection).from(bookings)
+    .leftJoin(offlineBookingPayments, eq(offlineBookingPayments.bookingId, bookings.id));
+  // Caller identity, never caller-supplied provider IDs or an administrative bypass.
+  const rows = input.view === "provider"
+    ? await base.innerJoin(serviceProviders, eq(serviceProviders.id, bookings.providerId))
+      .where(and(inArray(bookings.id, ids), eq(serviceProviders.userId, input.userId)))
+      .limit(BOOKING_LIST_PAYMENT_BATCH_SIZE)
+    : await base.where(and(inArray(bookings.id, ids), eq(bookings.customerId, input.userId)))
+      .limit(BOOKING_LIST_PAYMENT_BATCH_SIZE);
+
+  // All-or-nothing: no partial disclosure for mixed authorized/unauthorized requests.
+  if (rows.length !== ids.length || !ids.every(id => rows.some(row => row.bookingId === id))) {
+    throw new TRPCError({ code: "FORBIDDEN", message: "Unable to read this booking-list page." });
+  }
+  return rows.map(row => {
+    if (row.offlineBookingId === null) return { bookingId: row.bookingId, offlinePayment: null };
+    if (
+      row.offlineBookingId !== row.bookingId ||
+      !row.status || !["due", "paid", "waived"].includes(row.status) ||
+      typeof row.originalAmountDue !== "string" ||
+      !/^\d+(?:\.\d{1,2})?$/.test(row.originalAmountDue)
+    ) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Payment status unavailable." });
+    return {
+      bookingId: row.bookingId,
+      offlinePayment: {
+        status: row.status,
+        originalAmountDue: row.originalAmountDue,
+        outstandingBalance: row.status === "due" ? row.originalAmountDue : "0.00",
+      },
+    };
+  });
+}
