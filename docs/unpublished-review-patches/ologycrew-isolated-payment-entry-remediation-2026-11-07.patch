+import { randomUUID } from "node:crypto";
+import { and, eq, inArray } from "drizzle-orm";
+import {
+  auditLog,
+  crmActivityEvents,
+  crmContacts,
+  crmContactStageHistory,
+  crmOperationalState,
+  providerSubscriptions,
+  quoteRequests,
+  serviceProviders,
+  users,
+  type InsertUser,
+  type User,
+} from "../../drizzle/schema";
+import { CRM_PRIVATE_SETTING_KEYS, CRM_ROLLOUT_FLAGS } from "../../shared/crm";
+import { requireDb } from "../db/connection";
+
+const ISOLATED_DATABASE_URL = "mysql://isolated_regression@127.0.0.1:3337/ologycrew_payment_entry_remediation_20261107";
+
+/** Never connect or write using a merely similar URL or inherited credentials. */
+function assertCustomersPhase10Isolation(): void {
+  if (process.env.OLOGYCREW_HERMETIC_REGRESSION !== "1"
+    || process.env.DATABASE_URL !== ISOLATED_DATABASE_URL
+    || process.env.NODE_ENV !== "test") {
+    throw new Error("Customers Phase 10 fixtures require the exact isolated database URL, OLOGYCREW_HERMETIC_REGRESSION=1, and NODE_ENV=test");
+  }
+}
+
+/**
+ * Fixture contract:
+ * - Four generated users: ordinary customer, provider, admin without clearance role,
+ *   and explicitly synthetic super-admin. No owner email/openId is reused.
+ * - One active, non-official provider, an active Pro/basic subscription with no
+ *   Stripe references, and one customer quote establish real eligibility evidence.
+ * - The provider/customer identities deliberately use a non-reserved .invalid
+ *   domain and email login method: no reserved-test-identity override is requested.
+ * - Settings are newly inserted only when all CRM private keys are absent. Never
+ *   overwrite shared rollout rows; a conflicting suite must finish/clean up first.
+ * - All IDs come from inserts. Setup rolls back atomically on failure. Cleanup
+ *   deletes only those IDs and projection/audit rows scoped to the owned identities.
+ * - No service/category seed, taxonomy edit, external service, or router-result mock.
+ */
+export async function createCustomersPhase10Fixtures() {
+  assertCustomersPhase10Isolation();
+  const database = await requireDb();
+  const prefix = `remediation-customers-phase10-${randomUUID().slice(0, 12)}`;
+  const businessName = `Synthetic Phase 10 Audio ${prefix.slice(-12)}`;
+
+  const records = await database.transaction(async (tx) => {
+    assertCustomersPhase10Isolation();
+    const existingSettings = await tx.select({ id: crmOperationalState.id })
+      .from(crmOperationalState)
+      .where(inArray(crmOperationalState.settingKey, [...CRM_PRIVATE_SETTING_KEYS]));
+    if (existingSettings.length > 0) {
+      throw new Error("Customers Phase 10 requires unclaimed CRM private settings; refusing to overwrite another fixture's state");
+    }
+
+    const insertUser = async (suffix: string, overrides: Partial<InsertUser>): Promise<User> => {
+      assertCustomersPhase10Isolation();
+      const [inserted] = await tx.insert(users).values({
+        openId: `${prefix}-${suffix}`,
+        email: `${prefix}-${suffix}@customers-phase10.invalid`,
+        name: `Synthetic Phase 10 ${suffix}`,
+        firstName: "Synthetic",
+        lastName: `Phase10 ${suffix}`,
+        role: "customer",
+        adminRole: null,
+        loginMethod: "email",
+        authProvider: "email",
+        emailVerified: true,
+        hasSelectedRole: true,
+        deletedAt: null,
+        ...overrides,
+      }).$returningId();
+      if (!inserted) throw new Error(`Missing generated Phase 10 user ID: ${suffix}`);
+      const [user] = await tx.select().from(users).where(eq(users.id, inserted.id));
+      if (!user) throw new Error(`Missing inserted Phase 10 user: ${suffix}`);
+      return user;
+    };
+
+    // Existing adminPolicy explicitly permits @example.invalid only in test mode;
+    // use that contract without mocking authorization or impersonating an owner.
+    const superAdmin = await insertUser("super-admin", {
+      email: `${prefix}-super-admin@example.invalid`,
+      role: "admin",
+      adminRole: "super_admin",
+    });
+    const adminWithoutRole = await insertUser("admin-no-role", {
+      email: `${prefix}-admin-no-role@example.invalid`,
+      role: "admin",
+      adminRole: null,
+    });
+    const customer = await insertUser("customer", {});
+    const providerUser = await insertUser("provider", { role: "provider" });
+
+    assertCustomersPhase10Isolation();
+    const [provider] = await tx.insert(serviceProviders).values({
+      userId: providerUser.id,
+      businessName,
+      businessType: "sole_proprietor",
+      profileSlug: prefix,
+      isActive: true,
+      isOfficial: false,
+      deletedAt: null,
+    }).$returningId();
+    if (!provider) throw new Error("Missing generated Phase 10 provider ID");
+
+    assertCustomersPhase10Isolation();
+    const [subscription] = await tx.insert(providerSubscriptions).values({
+      providerId: provider.id,
+      tier: "basic",
+      status: "active",
+      stripeSubscriptionId: null,
+      stripeCustomerId: null,
+      cancelAtPeriodEnd: false,
+    }).$returningId();
+    if (!subscription) throw new Error("Missing generated Phase 10 subscription ID");
+
+    assertCustomersPhase10Isolation();
+    const [quote] = await tx.insert(quoteRequests).values({
+      providerId: provider.id,
+      customerId: customer.id,
+      serviceId: null,
+      categoryId: null,
+      title: `${prefix}-relationship`,
+      description: `Synthetic private quote from ${customer.email}; customerName and address must not appear in the assessment.`,
+      status: "pending",
+    }).$returningId();
+    if (!quote) throw new Error("Missing generated Phase 10 quote ID");
+
+    const settings: Array<{ settingKey: string; settingValue: string }> = [
+      { settingKey: "customersAudienceMode", settingValue: "pilot" },
+      { settingKey: "customersPilotProviderIds", settingValue: JSON.stringify([provider.id]) },
+      ...Object.values(CRM_ROLLOUT_FLAGS).map((settingKey) => ({
+        settingKey,
+        settingValue: settingKey === CRM_ROLLOUT_FLAGS.readUi ? "true" : "false",
+      })),
+      { settingKey: "customersProjectionMetrics", settingValue: JSON.stringify({ fixture: prefix, candidateCount: 0 }) },
+      { settingKey: "customersProjectionLastSuccessAt", settingValue: "2026-11-07T00:00:00.000Z" },
+      { settingKey: "customersProjectionLastError", settingValue: "" },
+      { settingKey: "customersBackfillCursor", settingValue: JSON.stringify({ providerId: provider.id, customerId: customer.id }) },
+      { settingKey: "customersBackfillLastRunId", settingValue: `${prefix}-baseline` },
+    ];
+    const settingIds: number[] = [];
+    for (const setting of settings) {
+      assertCustomersPhase10Isolation();
+      const [inserted] = await tx.insert(crmOperationalState).values({
+        ...setting,
+        updatedByUserId: superAdmin.id,
+      }).$returningId();
+      if (!inserted) throw new Error(`Missing generated Phase 10 setting ID: ${setting.settingKey}`);
+      settingIds.push(inserted.id);
+    }
+
+    return { superAdmin, adminWithoutRole, customer, providerUser, providerId: provider.id,
+      subscriptionId: subscription.id, quoteId: quote.id, settingIds };
+  });
+
+  const userIds = [records.superAdmin.id, records.adminWithoutRole.id, records.customer.id, records.providerUser.id];
+  let cleaned = false;
+
+  return {
+    ...records,
+    businessName,
+    /** Also detects operational/projection/audit writes beyond the original status checks. */
+    async snapshot() {
+      assertCustomersPhase10Isolation();
+      const [settings, contacts, events, stageHistory, audit] = await Promise.all([
+        database.select().from(crmOperationalState)
+          .where(inArray(crmOperationalState.settingKey, [...CRM_PRIVATE_SETTING_KEYS]))
+          .orderBy(crmOperationalState.id),
+        database.select().from(crmContacts).where(eq(crmContacts.providerId, records.providerId)).orderBy(crmContacts.id),
+        database.select().from(crmActivityEvents).where(eq(crmActivityEvents.providerId, records.providerId)).orderBy(crmActivityEvents.id),
+        database.select().from(crmContactStageHistory).where(eq(crmContactStageHistory.providerId, records.providerId)).orderBy(crmContactStageHistory.id),
