+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const appRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const originalRoot = "/home/ubuntu/service-scheduling-platform";
+export function copiedReadPath(value: unknown): unknown {
+  if (typeof value === "string" && (value === originalRoot || value.startsWith(`${originalRoot}/`))) {
+    return path.join(appRoot, value.slice(originalRoot.length));
+  }
+  return value;
+}
+
+/** Redirect paths only; bytes, existence checks, directory contents and errors
+ * are supplied by the copied real filesystem, never fabricated. */
+export function adaptCopiedReads<T extends Record<string, any>>(fs: T): T {
+  const adapted: Record<string, unknown> = { ...fs };
+  for (const key of ["readFileSync", "readFile", "existsSync", "readdirSync", "readdir", "statSync", "stat", "accessSync", "access", "realpathSync", "realpath", "createReadStream"]) {
+    if (typeof fs[key] === "function") {
+      adapted[key] = (file: unknown, ...args: unknown[]) => fs[key](copiedReadPath(file), ...args);
+    }
+  }
+  if (fs.promises) {
+    const promises = { ...fs.promises };
+    for (const key of ["readFile", "readdir", "stat", "access", "realpath"]) {
+      promises[key] = (file: unknown, ...args: unknown[]) => fs.promises[key](copiedReadPath(file), ...args);
+    }
+    adapted.promises = promises;
+  }
+  adapted.default = { ...(fs.default || fs), ...adapted };
+  return adapted as unknown as T;
+}
