+describe("Twilio Credentials Validation", () => {
+  it("should have TWILIO_PHONE_NUMBER set", () => {
+    const phone = ENV.twilioPhoneNumber;
+    expect(phone).toBeDefined();
+    expect(phone).toBeTruthy();
+    expect(phone!.startsWith("+")).toBe(true);
