+import express, { type RequestHandler } from "express";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import ts from "typescript";
+import { sdk } from "../server/_core/sdk";
+import { sseManager } from "../server/sseManager";
+import { assertIsolatedDatabase } from "./fixture-safety";
+
+/**
+ * Extract only the existing inline GET route. Never import index.ts: that would
+ * register writes/webhooks, serve Vite/static, start reminders and bind port 3000.
+ * Parsing the existing source makes handler/auth changes visible to these tests.
+ */
+export function existingSseHandler(): RequestHandler {
+  const sourcePath = path.resolve(import.meta.dirname, "../server/_core/index.ts");
+  const text = readFileSync(sourcePath, "utf8");
+  const source = ts.createSourceFile(sourcePath, text, ts.ScriptTarget.Latest, true);
+  const handlers: ts.Expression[] = [];
+  function visit(node: ts.Node): void {
+    if (ts.isCallExpression(node) && ts.isPropertyAccessExpression(node.expression) &&
+        node.expression.expression.getText(source) === "app" && node.expression.name.text === "get" &&
+        node.arguments.length === 2 && ts.isStringLiteral(node.arguments[0]) &&
+        node.arguments[0].text === "/api/sse/notifications") {
+      handlers.push(node.arguments[1]);
+    }
+    ts.forEachChild(node, visit);
+  }
+  visit(source);
+  if (handlers.length !== 1 || !ts.isArrowFunction(handlers[0])) {
+    throw new Error("Expected exactly one inline existing SSE GET handler; review bootstrap changes");
+  }
+  const expression = handlers[0].getText(source);
+  if (!expression.includes("sdk.authenticateRequest") || !expression.includes("sseManager.addClient")) {
+    throw new Error("Existing SSE handler no longer uses expected application auth/manager boundaries");
+  }
+  const compiled = ts.transpileModule(`const handler = ${expression};`, {
+    compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.None },
+  }).outputText;
+  return new Function("sdk", "sseManager", `${compiled}\nreturn handler;`)(sdk, sseManager) as RequestHandler;
+}
+
+export async function startReadOnlySseServer() {
+  assertIsolatedDatabase();
+  const app = express();
+  app.disable("x-powered-by");
+  app.get("/api/sse/notifications", existingSseHandler());
+  const server = createServer(app);
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      server.off("error", reject);
+      resolve();
+    });
+  });
+  const address = server.address() as AddressInfo;
+  return {
+    origin: `http://127.0.0.1:${address.port}`,
+    close: async () => {
+      server.closeAllConnections();
+      await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    },
+  };
+}
