+  return adaptCopiedReads(actual);
+});
+
+assertIsolatedDatabase();
+if (process.env.NODE_ENV !== "test") throw new Error("Hermetic setup requires NODE_ENV=test");
+for (const key of [
+  "FACEBOOK_PAGE_ACCESS_TOKEN", "FACEBOOK_APP_SECRET", "LINKEDIN_ACCESS_TOKEN", "LINKEDIN_CLIENT_SECRET",
+  "GOOGLE_CLIENT_SECRET", "SENDGRID_API_KEY", "TWILIO_ACCOUNT_SID", "TWILIO_AUTH_TOKEN",
+  "TWILIO_MESSAGING_SERVICE_SID", "PARTNER_STRIPE_ACCOUNT_ID", "VAPID_PRIVATE_KEY",
+  "VAPID_PUBLIC_KEY", "VITE_VAPID_PUBLIC_KEY", "BUILT_IN_FORGE_API_KEY", "VITE_FRONTEND_FORGE_API_KEY",
+  "STRIPE_DEV_SECRET_KEY", "STRIPE_WEBHOOK_SECRET",
+]) {
+  if (process.env[key]) throw new Error(`Inherited external configuration forbidden in hermetic setup: ${key}`);
+}
+if (process.env.STRIPE_SECRET_KEY !== "hermetic-import-marker-not-a-credential") {
+  throw new Error("Only the explicit non-authenticating Stripe SDK import marker is permitted");
+}
+
+// This is a denial guard, not a mock. Unexpected external requests remain a
+// failing test even when application code catches the exception and falls back.
+const attempted: string[] = [];
+const nativeFetch = globalThis.fetch;
+globalThis.fetch = createGuardedFetch(nativeFetch, attempted);
+
+const nativeConnect = net.Socket.prototype.connect;
+net.Socket.prototype.connect = function (...args: any[]) {
+  let options: any = args[0];
+  if (Array.isArray(options)) options = options[0];
+  const host = typeof options === "object" ? options.host ?? "localhost" :
+    typeof args[1] === "string" ? args[1] : "localhost";
+  const port = typeof options === "object" ? options.port : options;
+  const socketPath = typeof options === "object" ? options.path : typeof options === "string" ? options : undefined;
+  if (socketPath || !["127.0.0.1", "localhost", "::1"].includes(host) ||
+      !Number.isInteger(Number(port)) || [3000, 3306].includes(Number(port))) {
+    attempted.push(`socket ${String(host)}:${String(port)}`);
+    throw new Error("Hermetic non-approved socket destination forbidden");
+  }
+  return nativeConnect.apply(this, args as any);
+} as typeof nativeConnect;
+
+afterAll(() => {
+  globalThis.fetch = nativeFetch;
+  net.Socket.prototype.connect = nativeConnect;
+  if (attempted.length) throw new Error(`Unexpected unmocked external boundary attempts: ${attempted.join(", ")}`);
+});
