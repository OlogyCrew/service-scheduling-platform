+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ getDb: vi.fn() }));
+vi.mock("./db/connection", () => mocks);
+import { getOfflinePaymentForBooking } from "./db/offlinePayments";
+
+describe("offline ledger read failure is not online payment permission", () => {
+  beforeEach(() => vi.resetAllMocks());
+
+  it("rejects unavailable storage rather than returning no offline obligation", async () => {
+    mocks.getDb.mockResolvedValue(null);
+    await expect(getOfflinePaymentForBooking(9001)).rejects.toThrow("Offline payment status is unavailable");
+  });
+
+  it("propagates query failure instead of returning null", async () => {
+    const failure = new Error("synthetic isolated read failure");
+    const query: any = {};
+    for (const name of ["from", "innerJoin", "where"]) query[name] = vi.fn(() => query);
+    query.limit = vi.fn().mockRejectedValue(failure);
+    mocks.getDb.mockResolvedValue({ select: vi.fn(() => query) });
+    await expect(getOfflinePaymentForBooking(9001)).rejects.toBe(failure);
+  });
+
+  it("returns null only after a successful query with no offline ledger row", async () => {
+    const query: any = {};
+    for (const name of ["from", "innerJoin", "where"]) query[name] = vi.fn(() => query);
+    query.limit = vi.fn().mockResolvedValue([]);
+    mocks.getDb.mockResolvedValue({ select: vi.fn(() => query) });
+    await expect(getOfflinePaymentForBooking(9001)).resolves.toBeNull();
+    expect(query.limit).toHaveBeenCalledWith(1);
+  });
+});
