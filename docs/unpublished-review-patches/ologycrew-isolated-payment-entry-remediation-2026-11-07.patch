+    database,
+    requests,
+    expectedSql,
+    /** Clear only this fixture's owned row (ID 210) and request state. */
+    cleanup() {
+      ownedRows.delete(SYNTHETIC_HOLISTIC_CATEGORY.id);
+      requests.length = 0;
+      disposed = true;
+    },
+  };
