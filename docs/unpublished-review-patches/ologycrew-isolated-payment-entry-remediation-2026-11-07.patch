+/** Minimal, read-only payment projection for one caller-owned booking-list page. */
+export const BOOKING_LIST_PAYMENT_BATCH_SIZE = 10;
+
+export type BookingListPaymentSummary = {
+  bookingId: number;
+  // Only an explicit null from a successful authorized read establishes no offline ledger.
+  offlinePayment: {
+    status: "due" | "paid" | "waived";
+    originalAmountDue: string;
+    outstandingBalance: string;
+  } | null;
+};
+
+export type BookingListPaymentReadState = "ready" | "loading" | "error" | "unknown";
+
+export type BookingListPaymentPresentation =
+  | { kind: "online" }
+  | { kind: "loading" | "error" | "unknown" }
+  | {
+      kind: "offline";
+      status: "due" | "paid" | "waived";
+      statusLabel: "Due" | "Paid" | "Waived";
+      originalAmount: string;
+      outstandingBalance: string;
+    };
+
+/** Never infer online payment eligibility from missing, stale or failed list data. */
+export function getBookingListPaymentPresentation(
+  bookingId: number,
+  summary: BookingListPaymentSummary | undefined,
+  readState: BookingListPaymentReadState,
+): BookingListPaymentPresentation {
+  if (readState !== "ready") return { kind: readState };
+  if (!summary || summary.bookingId !== bookingId) return { kind: "unknown" };
+  if (summary.offlinePayment === null) return { kind: "online" };
+  const payment = summary.offlinePayment;
+  if (
+    !payment ||
+    !["due", "paid", "waived"].includes(payment.status) ||
+    typeof payment.originalAmountDue !== "string" ||
+    !/^\d+(?:\.\d{1,2})?$/.test(payment.originalAmountDue) ||
+    !Number.isFinite(Number(payment.originalAmountDue))
+  ) return { kind: "unknown" };
+  // Existing settlement is full-only. Keep the historical agreement separate from balance.
+  const outstandingBalance = payment.status === "due" ? payment.originalAmountDue : "0.00";
+  if (payment.outstandingBalance !== outstandingBalance) return { kind: "unknown" };
+  return {
+    kind: "offline",
+    status: payment.status,
+    statusLabel: { due: "Due", paid: "Paid", waived: "Waived" }[payment.status] as "Due" | "Paid" | "Waived",
+    originalAmount: payment.originalAmountDue,
+    outstandingBalance,
+  };
+}
