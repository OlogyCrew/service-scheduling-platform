+  if (process.env.OLOGYCREW_HERMETIC !== "1") {
+    throw new Error("Refusing harness use without the isolated hermetic runner");
+  }
+  if (!value) throw new Error("Isolated DATABASE_URL is required");
+  const url = new URL(value);
+  if (url.protocol !== "mysql:" || url.hostname !== "127.0.0.1" || url.port !== ISOLATED_PORT ||
+      url.pathname !== `/${ISOLATED_DATABASE}` || url.search || url.hash) {
+    throw new Error("Refusing any database other than the exact disposable loopback database on port 3337");
+  }
+  return url;
+}
+
+export function fixturePrefix(suite: string): string {
+  const label = suite.toLowerCase().replace(/[^a-z0-9-]/g, "-").slice(0, 25);
+  return `remediation-${label}-${randomUUID().slice(0, 8)}`;
+}
+
+export function syntheticEmail(suite: string, suffix = "user"): string {
+  return `${fixturePrefix(suite)}-${suffix.replace(/[^a-zA-Z0-9-]/g, "-")}@example.invalid`;
+}
