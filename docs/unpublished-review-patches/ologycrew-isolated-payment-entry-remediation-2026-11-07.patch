+export function assertHolisticShareFixtureGate() {
+  if (
+    process.env.OLOGYCREW_HERMETIC_REGRESSION !== "1" ||
+    process.env.DATABASE_URL !== ISOLATED_DATABASE_URL
+  ) {
+    throw new Error(
+      "holistic-share synthetic fixtures require OLOGYCREW_HERMETIC_REGRESSION=1 and the exact approved isolated DATABASE_URL",
+    );
+  }
+}
+
+export type HolisticShareFixtureRequest = {
+  sql: string;
+  params: unknown[];
+  method: "all" | "execute";
+};
