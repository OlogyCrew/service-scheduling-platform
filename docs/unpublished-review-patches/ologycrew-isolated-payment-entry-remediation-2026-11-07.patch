+/**
+ * The real services.getCategoryBySlug and real Drizzle query builder execute
+ * against this strictly read-only, per-test synthetic driver boundary. This is
+ * not a mocked services result, and cannot read or mutate the shared database.
+ * Only the category slug SELECT with LIMIT 1 is accepted; any other SQL fails.
+ */
+export function createReadOnlyHolisticCategoryFixture() {
+  assertHolisticShareFixtureGate();
+  const columns = getTableColumns(serviceCategories);
+  const keys = Object.keys(columns) as (keyof ServiceCategory)[];
+  const requests: HolisticShareFixtureRequest[] = [];
+  const ownedRows = new Map<number, Readonly<ServiceCategory>>([
+    [SYNTHETIC_HOLISTIC_CATEGORY.id, SYNTHETIC_HOLISTIC_CATEGORY],
+  ]);
+  let disposed = false;
+
+  const expectedSql =
+    `select ${keys.map(key => `\`${columns[key].name}\``).join(", ")} ` +
+    "from `service_categories` where `service_categories`.`slug` = ? limit ?";
+
+  const database = drizzle(async (sql, params, method) => {
+    assertHolisticShareFixtureGate();
+    if (disposed) throw new Error("holistic-share fixture is already disposed");
+    if (
+      method !== "all" ||
+      sql !== expectedSql ||
+      params.length !== 2 ||
+      typeof params[0] !== "string" ||
+      params[1] !== 1
+    ) {
+      throw new Error("holistic-share fixture rejects non-contract SQL (including all writes)");
+    }
+    requests.push({ sql, params: [...params], method });
+    const row = Array.from(ownedRows.values()).find(category => category.slug === params[0]);
+    return {
+      rows: row
+        ? [keys.map(key => columns[key].mapToDriverValue(row[key]))]
+        : [],
+    };
+  }, { schema: { serviceCategories } });
