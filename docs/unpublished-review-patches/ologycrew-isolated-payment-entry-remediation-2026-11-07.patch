+import { externalHealthFiles, mixedHealthFiles, additionalLocalContractFiles } from "./test-harness/partition";
+
+const root = path.resolve(import.meta.dirname);
+assertIsolatedDatabase();
+const original = readFileSync(path.resolve(root, "test-harness/inventory/original-test-files.txt"), "utf8")
+  .trim().split("\n");
+const routedHealth = new Set<string>([...externalHealthFiles, ...Object.keys(mixedHealthFiles)]);
+const included = [...original.filter(file => !routedHealth.has(file)), ...additionalLocalContractFiles];
+const healthInventory = JSON.parse(readFileSync(path.resolve(root, "test-harness/inventory/external-health-inventory.json"), "utf8"));
+for (const entry of healthInventory.cases as Array<{ file: string; sha256: string }>) {
+  const originalBytes = readFileSync(path.resolve(root, entry.file));
+  const preservedBytes = readFileSync(path.resolve(root, "test-harness/inventory/preserved-external-health", path.basename(entry.file) + ".txt"));
+  for (const bytes of [originalBytes, preservedBytes]) {
+    if (createHash("sha256").update(bytes).digest("hex") !== entry.sha256) {
+      throw new Error(`Preserved external-health original changed: ${entry.file}`);
+    }
+  }
+}
+
+function discover(dir: string): string[] {
+  return readdirSync(path.resolve(root, dir), { withFileTypes: true }).flatMap(entry => {
+    const relative = `${dir}/${entry.name}`;
+    return entry.isDirectory() ? discover(relative) : /\.(test|spec)\.tsx?$/.test(entry.name) ? [relative] : [];
+  });
+}
+const accounted = new Set([...original, ...additionalLocalContractFiles]);
+for (const file of [...discover("server"), ...discover("test-harness")]) {
+  if (!accounted.has(file)) throw new Error(`Unaccounted test file: ${file}; update the explicit inventory, do not silently omit`);
+}
+for (const file of [...original, ...additionalLocalContractFiles]) {
+  readFileSync(path.resolve(root, file)); // Missing inventory entries are a hard error.
+}
+
+export default defineConfig({
+  root,
+  // Never load the inherited or copied project .env files.
+  envDir: false,
+  resolve: { alias: {
+    "@": path.resolve(root, "client/src"),
+    "@shared": path.resolve(root, "shared"),
+    "@assets": path.resolve(root, "attached_assets"),
+    "dotenv/config": path.resolve(root, "test-harness/no-dotenv.ts"),
+  } },
+  test: {
+    environment: "node",
+    include: included,
+    exclude: [],
+    setupFiles: ["test-harness/setup.ts"],
+    // Do not use the original teardown that disables FK checks and deletes broad
+    // namespaces. Fixture owners clean their own rows; parent drops disposable DB.
+    globalSetup: [],
+    fileParallelism: false,
+    isolate: true,
+    testTimeout: 15000,
+    hookTimeout: 30000,
+  },
+});
